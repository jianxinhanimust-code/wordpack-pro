{
  "name": "wordpack-pro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WordPack Pro 拆词记进阶版",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server/start.mjs",
    "build:pages": "node scripts/build_pages.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "node --test server/ai.spec-node.mjs",
    "test:offline": "node server/offline.check.mjs",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit",
    "wordlists:build": "python scripts/build_ecdict.py",
    "icons": "python scripts/make_icons.py",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "lucide-react": "^1.77.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ts-fsrs": "^6.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.8",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  }
}
